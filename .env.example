# AlgoWash Environment Variables Template (NEVER COMMIT REAL SECRETS)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-32-byte-secure-secret-key"

# Google OAuth 2.0 (Scope: https://www.googleapis.com/auth/youtube.force-ssl)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Gemini API (For Theme Keyword & Video Curation)
GEMINI_API_KEY="your-gemini-api-key"

# Optional Serverless Cache (Vercel KV / Upstash Redis)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
